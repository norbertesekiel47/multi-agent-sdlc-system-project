# SDLC-Swarm — environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Never commit real secrets.

# =============================================================================
# LLM gateway — all agent chat/completion calls go through OpenRouter.
# Get a key at: https://openrouter.ai/keys
# =============================================================================
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model IDs (verified in mission-readiness check; adjust if OpenRouter
# renames them). The orchestrator routes per-agent via these env vars.
PLANNER_MODEL=deepseek/deepseek-chat
CODER_MODEL=deepseek/deepseek-chat
REVIEWER_MODEL=deepseek/deepseek-chat
QA_MODEL=deepseek/deepseek-chat

# =============================================================================
# Embeddings — pgvector RAG over the target repository.
# OpenRouter does NOT proxy embeddings, so a direct provider key is needed.
# Get a key at: https://platform.openai.com/api-keys
# =============================================================================
OPENAI_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# GitHub — hand-rolled client uses this PAT to clone, branch, commit, push,
# and open pull requests. Use a fine-grained token with these permissions:
#   - Contents: Read & write
#   - Pull requests: Read & write
#   - Issues: Read
#   - Metadata: Read (auto)
# Generate at: https://github.com/settings/tokens?type=beta
# =============================================================================
GITHUB_PAT=github_pat_REPLACE_ME
GITHUB_USERNAME=norbertesekiel
# Default branch prefix used when the Coder pushes work.
GITHUB_BRANCH_PREFIX=sdlc-swarm/

# =============================================================================
# SWE-bench dataset — primary benchmark.
# The official evaluator pulls dataset rows from Hugging Face and pulls
# per-instance Docker images. A read-scope token is sufficient.
# Generate at: https://huggingface.co/settings/tokens
# =============================================================================
HUGGINGFACE_TOKEN=hf_REPLACE_ME
SWEBENCH_DATASET=princeton-nlp/SWE-bench_Lite
SWEBENCH_SPLIT=test

# =============================================================================
# Langfuse — self-hosted observability. Bring up the docker-compose stack
# first (see infra/docker-compose.yml once Phase 1 lands), then create a
# project in the Langfuse UI at http://localhost:3110 and paste the keys here.
# Leave blank until the stack is running; the app degrades gracefully.
# =============================================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3110

# =============================================================================
# Postgres (used for both pgvector RAG and the hand-rolled episodic memory
# store). Brought up by the local docker-compose stack.
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=sdlc_swarm
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=sdlc_swarm

# =============================================================================
# App ports (mission-boundary range: 3100-3199). Hardcoded so workers don't
# clash with each other or with the user's main dev environment.
# =============================================================================
API_PORT=3100
WEB_PORT=3101
LANGFUSE_PORT=3110

# =============================================================================
# Sandbox — Docker network policy & resource caps for ephemeral task
# containers. The registry allowlist is enforced via an iptables-restricted
# Docker network created at app boot.
# =============================================================================
SANDBOX_IMAGE_PREFIX=sdlc-swarm-sandbox
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_CPU_LIMIT=2
SANDBOX_TIMEOUT_SECONDS=600

# =============================================================================
# Cost guardrails — mission-level safety on LLM spend.
# =============================================================================
MAX_COST_PER_TASK_USD=2.00
MAX_RETRIES_PER_AGENT_STEP=3
LOOP_DETECTION_WINDOW=5
LOOP_DETECTION_THRESHOLD=3
PYDANTIC_VALIDATION_FAIL_THRESHOLD=3
TOOL_ERROR_RATE_WINDOW=10
TOOL_ERROR_RATE_THRESHOLD=0.5
